## 3. Extension Architecture

### 3.1 Manifest (v2/v3 hybrid, Firefox uses v2 style contextualIdentities today)

```json
{
  "manifest_version": 2,
  "name": "Company Containers",
  "version": "1.0.0",
  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": { "id": "company-containers@example.com" }
  }
}
```

### 3.2 Data Model

Store rules as a flat lookup table, keyed by a normalized hostname pattern:

```js
const DEFAULT_RULES = {
  "google": {
    color: "blue",
    icon: "circle",
    domains: ["google.com", "youtube.com", "gmail.com", "drive.google.com", "..."]
  },
  "microsoft": {
    color: "turquoise",
    icon: "briefcase",
    domains: ["microsoft.com", "outlook.com", "github.com", "linkedin.com", "..."]
  },
  "meta": {
    color: "red",
    icon: "fingerprint",
    domains: ["facebook.com", "instagram.com", "whatsapp.com", "..."]
  }
};
```

At install time, iterate this object and call `browser.contextualIdentities.create()` once per company to generate the actual container objects, then persist the returned `cookieStoreId` values in `storage.local` so you're not recreating containers on every browser start.

```js
async function ensureContainersExist() {
  const existing = await browser.contextualIdentities.query({});
  for (const [name, rule] of Object.entries(DEFAULT_RULES)) {
    if (!existing.find(c => c.name.toLowerCase() === name)) {
      const identity = await browser.contextualIdentities.create({
        name: name.charAt(0).toUpperCase() + name.slice(1),
        color: rule.color,
        icon: rule.icon
      });
      await saveContainerId(name, identity.cookieStoreId);
    }
  }
}
```

### 3.3 The Reassignment Engine

Firefox does not allow changing a tab's container after creation — you have to close the original tab and open a new one in the target container. This is the same mechanism Multi-Account Containers uses under the hood.

```js
browser.webRequest.onBeforeRequest.addListener(
  handleNavigation,
  { urls: ["<all_urls>"], types: ["main_frame"] },
  ["blocking"]
);

async function handleNavigation(details) {
  const url = new URL(details.url);
  const targetContainer = matchDomainToContainer(url.hostname);
  const tab = await browser.tabs.get(details.tabId);
  const currentCookieStoreId = tab.cookieStoreId;

  if (targetContainer && targetContainer !== currentCookieStoreId) {
    await reopenTabInContainer(tab, details.url, targetContainer);
    return { cancel: true };
  }

  if (!targetContainer && !isTemporaryContainer(currentCookieStoreId)) {
    const tempContainer = await createTemporaryContainer();
    await reopenTabInContainer(tab, details.url, tempContainer);
    return { cancel: true };
  }

  return {};
}

function matchDomainToContainer(hostname) {
  for (const [name, rule] of Object.entries(DEFAULT_RULES)) {
    if (rule.domains.some(d => hostname === d || hostname.endsWith("." + d))) {
      return getSavedContainerId(name);
    }
  }
  return null;
}

async function reopenTabInContainer(tab, url, cookieStoreId) {
  await browser.tabs.create({
    url,
    cookieStoreId,
    index: tab.index,
    active: tab.active,
    windowId: tab.windowId
  });
  await browser.tabs.remove(tab.id);
}
```

### 3.4 Temporary Container Fallback

Mirrors Temporary Containers' approach: create a uniquely-named container on demand, tag it in `storage.local` as temporary, and garbage-collect it once its last tab closes.

```js
let tempContainerCounter = 0;

async function createTemporaryContainer() {
  const identity = await browser.contextualIdentities.create({
    name: `Temp ${++tempContainerCounter}`,
    color: "toolbar",
    icon: "circle"
  });
  await markAsTemporary(identity.cookieStoreId);
  return identity.cookieStoreId;
}

browser.tabs.onRemoved.addListener(async (tabId) => {
  const remainingTabs = await browser.tabs.query({});
  const allCookieStoreIds = new Set(remainingTabs.map(t => t.cookieStoreId));
  const tempIds = await getAllTemporaryContainerIds();

  for (const id of tempIds) {
    if (!allCookieStoreIds.has(id)) {
      await browser.contextualIdentities.remove(id);
      await unmarkTemporary(id);
    }
  }
});
```

### 3.5 External Link Handling

This is the piece that needs OS-level integration, not just background-script logic, because it has to catch links clicked from *outside* the browser (email clients, Slack desktop, terminal, etc.).

**Approach**: register a custom protocol handler, same pattern as "Open External Links in a Container."

In `manifest.json`:
```json
"protocol_handlers": [
  {
    "protocol": "ext+container",
    "name": "Company Containers",
    "uriTemplate": "https://dummy/#%s"
  }
]
```

Then a small companion launcher script (bash on Linux, a tiny compiled binary on macOS/Windows registered as the default `http`/`https` handler) rewrites incoming URLs into the `ext+container:` scheme before handing them to Firefox, e.g.:

```bash
#!/bin/bash
URL="$1"
firefox "ext+container:name=Google&url=$URL"
```

The extension's background script listens for this custom scheme, parses out `name` and `url`, matches `name` against `DEFAULT_RULES`, and opens the tab in that container — falling back to the temporary-container logic if no match is found, exactly like normal in-browser navigation.

