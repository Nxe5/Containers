{
  "manifest_version": 2,
  "name": "Better Containers",
  "version": "1.0.0",
  "description": "Auto-isolate YouTube, Gmail, GitHub, and Amazon in their own containers; unmatched sites open in temporary containers.",
  "homepage_url": "https://github.com/Nxe5/Containers",
  "icons": {
    "48": "src/icons/icon.svg",
    "96": "src/icons/icon.svg"
  },
  "browser_action": {
    "default_title": "Better Containers",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon.svg",
      "32": "src/icons/icon.svg"
    }
  },
  "background": {
    "page": "src/background/background.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "idle",
    "<all_urls>"
  ],
  "optional_permissions": [
    "proxy",
    "nativeMessaging"
  ],
  "protocol_handlers": [
    {
      "protocol": "ext+container",
      "name": "Better Containers",
      "uriTemplate": "/src/opener/opener.html#%s"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{d2e31876-bc5b-4d3c-b649-4b1faec96a87}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
